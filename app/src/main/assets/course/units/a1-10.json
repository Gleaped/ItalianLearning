        "answers": [
          "ha"
        ],
        "explanation": "Age uses avere."
      }
    },
    {
      "id": "a1-10-t2",
      "rule": "Ordinare: vorrei",
      "tip": "Vorrei + thing is the polite way to order.",
      "example": {
        "it": "Vorrei un caffè, per favore.",
        "en": "I would like a coffee, please."
      },
      "challenge": {
