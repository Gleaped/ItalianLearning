  "grammarTips": [
    {
      "id": "a1-10-t1",
      "rule": "Età con avere",
      "tip": "Italian uses avere for age: ho trent'anni, not sono trent'anni.",
      "example": {
        "it": "Mia sorella ha ventidue anni.",
        "en": "My sister is twenty-two."
      },
      "challenge": {
