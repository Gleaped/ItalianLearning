        ]
      }
    },
    {
      "id": "a1-05-t2",
      "rule": "Ventuno, ventotto",
      "tip": "Before uno and otto the tens lose their last vowel: ventuno, trentotto. Tré takes an accent: ventitré.",
      "example": {
        "it": "Sono ventuno euro.",
        "en": "That is twenty-one euros."
      },
      "challenge": {
