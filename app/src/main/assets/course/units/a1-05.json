    {
      "id": "a1-05-t1",
      "rule": "Numeri 11–19",
      "tip": "11–16 end in -dici (undici … sedici); 17, 18 and 19 start with dici-: diciassette.",
      "example": {
        "it": "Ho diciassette euro.",
        "en": "I have seventeen euros."
      },
      "challenge": {
