    {
      "id": "a1-03-l1",
      "title": "Io lavoro, tu lavori",
      "minutes": 8,
      "goal": "You can say what you do (io), ask a friend (tu) and talk about someone (lui / lei).",
      "takeaway": "-are verbs: take off -are and add -o, -i, -a.",
      "exercises": [
        {
          "type": "gap_fill",
          "id": "a1-03-l1-e01",
