          ],
          "answer": 0,
          "explanation": "Come ti chiami? asks for a name."
        },
        {
          "type": "minimal_pair",
          "id": "a1-01-l2-e05",
          "stage": "practise",
          "instruction": "Read the sentences and choose.",
          "sentences": [
            "Come ti chiami?",
            "Come si chiama?"
