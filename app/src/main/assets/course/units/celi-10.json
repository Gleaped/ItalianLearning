          "answers": [
            "vantaggiosa"
          ],
          "explanation": "vantaggio → vantaggioso (idea → -a).",
          "id": "celi-10-l2-e08"
        },
        {
          "type": "match_pairs",
          "instruction": "Abbina il nome all'aggettivo.",
          "pairs": [
            {
              "left": "la paura",
