  "grammarTips": [
    {
      "id": "a1-02-t1",
      "rule": "-o maschile, -a femminile",
      "tip": "Most nouns in -o are masculine, in -a feminine. For -e nouns, learn the article too.",
      "example": {
        "it": "Il gelato e la pizza.",
        "en": "The ice cream and the pizza."
      },
      "challenge": {
        "type": "multiple_choice",
        "prompt": "Which is feminine?",
        "options": [
          "il cornetto",
          "la birra",
          "il gelato"
        ],
        "answer": 1,
        "explanation": "Birra ends in -a, so it is feminine."
      }
    },
    {
      "id": "a1-02-t2",
      "rule": "Un, uno, una, un'",
      "tip": "un before most masculine words, uno before s + consonant or z, una / un' for feminine.",
      "example": {
        "it": "Uno studente e un'amica.",
        "en": "A student and a (female) friend."
      },
      "challenge": {
        "type": "gap_fill",
        "sentence": "___ zaino",
        "answers": [
          "uno",
          "Uno"
        ],
        "explanation": "Zaino starts with z, so it takes uno."
      }
    },
    {
      "id": "a1-02-t3",
      "rule": "Il, lo, la, l'",
      "tip": "The: il / lo / la; l' before a vowel (both genders). Lo goes before s + consonant or z.",
      "example": {
        "it": "Lo studente e l'amica.",
        "en": "The student and the friend."
      },
      "challenge": {
        "type": "multiple_choice",
        "prompt": "___ amico",
        "options": [
          "il",
          "lo",
          "l'"
        ],
        "answer": 2,
        "explanation": "Before a vowel the article is l'."
      }
    },
    {
      "id": "a1-02-t4",
      "rule": "Plurali: -o→-i, -a→-e",
      "tip": "Nouns: -o → -i, -a → -e, -e → -i. Words with a final accent do not change.",
      "example": {
        "it": "Due cornetti e tre pizze.",
        "en": "Two croissants and three pizzas."
      },
      "challenge": {
        "type": "gap_fill",
        "sentence": "tre ___ (pizza)",
        "answers": [
          "pizze"
        ],
        "explanation": "Pizza ends in -a: the plural is -e."
      }
    },
    {
      "id": "a1-02-t5",
      "rule": "I, gli, le",
      "tip": "Plural the: il → i, lo and l' (masc.) → gli, la and l' (fem.) → le.",
